{
  "name": "baidu-map-server",
  "compatibility_date": "2025-04-30",
  "main": "baidumap-server/src/index.js",
  "routes": [
    {
      "pattern": "/*",
      "script": "baidu-map-server"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "NODE_ENV": "production"
      }
    }
  }
} 